{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "load-config",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "fitnessllm_shared.utils.config_loader",
                "${workspaceFolder}/../.config/fitnessllm-ai/config.json"
